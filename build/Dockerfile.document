FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/gen \
    PADDLE_PDX_CACHE_HOME=/opt/paddlex \
    UV_PYTHON_DOWNLOADS=0 \
    PADDLE_PDX_MODEL_SOURCE=modelscope \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

RUN apt-get update && apt-get install -y --no-install-recommends \
        fonts-dejavu-core \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY document/pyproject.toml ./
COPY document/src ./src
RUN --mount=from=ghcr.io/astral-sh/uv:0.12.19,source=/uv,target=/bin/uv \
    uv pip install --system --no-cache .

RUN mkdir -p /opt/paddlex && python -c "from paddleocr import PaddleOCR; PaddleOCR(lang='ru', ocr_version='PP-OCRv5', text_detection_model_name='PP-OCRv5_mobile_det', text_recognition_model_name='eslav_PP-OCRv5_mobile_rec', device='cpu', enable_mkldnn=False, use_doc_orientation_classify=False, use_doc_unwarping=False, use_textline_orientation=False)"

RUN groupadd --system app && useradd --system --gid app --home-dir /app app
RUN chown -R app:app /opt/paddlex

WORKDIR /app
COPY document/gen ./gen

USER app
ENTRYPOINT ["python", "-m", "delim_document.main"]
