# Production environment for Delim. Copy to deployments/prod/.env and fill with
# STRONG, UNIQUE values. `make prod-check` fails fast on anything weak, missing,
# localhost, wildcard CORS, or non-HTTPS.
#
# Secrets must be at least 32 characters and mutually distinct:
#   GATEWAY_SESSION_SECRET, GATEWAY_INVITE_SECRET, MAX_WEBHOOK_SECRET.

POSTGRES_USER=delim
POSTGRES_PASSWORD=

MINIO_ROOT_USER=delim
MINIO_ROOT_PASSWORD=

MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_URL=https://REPLACE_WITH_PUBLIC_HOST/api/v1/max/webhook
MAX_MINI_APP_URL=https://REPLACE_WITH_PUBLIC_HOST/

GATEWAY_SESSION_SECRET=
GATEWAY_INVITE_SECRET=
# Same-origin behind Caddy; leave empty unless the API is served from a
# different origin than the Mini App. Never use a wildcard.
GATEWAY_CORS_ALLOWED_ORIGINS=

# Public HTTPS host served by Caddy (no scheme). Used by prod-check too.
DELIM_PUBLIC_HOST=REPLACE_WITH_PUBLIC_HOST
